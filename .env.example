# Application
APP_ENV=development
APP_NAME="AI Care Coordination Platform"
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
# For local dev you can fall back to sqlite by leaving DATABASE_URL unset.
# Postgres example:
# DATABASE_URL=postgresql+psycopg://care:care@localhost:5432/care
DATABASE_URL=

# Storage (for uploaded documents / voice notes)
STORAGE_DIR=./storage

# AI providers (kept abstract; pipelines are pluggable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Timezone for reminders/summaries
DEFAULT_TIMEZONE=Asia/Kolkata
